---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Gioca online — Battaglia Navale';
const description =
  'Play online: run battaglia_navale.py server-web — the same file serves the UI and game API.';
---

<BaseLayout title={title} description={description} path="/gioca">
  <div class="page">
    <header class="top">
      <a href="/">Home</a>
      <h1>Play online</h1>
      <p>
        Start <code>python3 battaglia_navale.py server-web 0.0.0.0 8080</code> and open
        <strong>http://&lt;host&gt;:8080/</strong> — UI, powers, and engine are all in that single Python file.
      </p>
    </header>

    <section class="setup">
      <label>
        Game server URL (if already running)
        <input id="api-base" type="url" inputmode="url" placeholder="http://127.0.0.1:8080" />
      </label>
      <button type="button" id="btn-open" class="btn primary">Open game UI</button>
      <p id="status" class="status" role="status"></p>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    width: min(960px, 100% - 1.5rem);
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .top a {
    color: #22d3ee;
    text-decoration: none;
    font-size: 0.875rem;
  }

  h1 {
    margin: 0.5rem 0;
    font-size: clamp(1.5rem, 4vw, 2rem);
    color: #f8fafc;
  }

  .top p {
    color: #94a3b8;
    font-size: 0.9375rem;
  }

  .setup {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 8px;
    background: rgba(15, 40, 65, 0.35);
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: #cbd5e1;
  }

  input {
    padding: 0.65rem 0.75rem;
    border-radius: 6px;
    border: 1px solid #334155;
    background: #020617;
    color: #e2e8f0;
    font-size: 1rem;
  }

  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn {
    padding: 0.55rem 1rem;
    border-radius: 6px;
    border: 1px solid #334155;
    background: #0f172a;
    color: #e2e8f0;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
  }

  .btn.primary {
    background: #0284c7;
    border-color: #0284c7;
    color: #f0f9ff;
  }

  .status {
    min-height: 1.25rem;
    color: #7dd3fc;
    font-size: 0.875rem;
  }

  .hint {
    font-size: 0.8125rem;
    color: #64748b;
    margin: 0;
  }

  .boards {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 720px) {
    .boards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .board-wrap h2 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748b;
    margin: 0 0 0.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 2px;
    max-width: 100%;
    touch-action: manipulation;
  }

  .cell {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, monospace;
    font-size: clamp(0.65rem, 2.8vw, 0.85rem);
    font-weight: 600;
    border-radius: 3px;
    background: #0c4a6e;
    color: #bae6fd;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .cell.water {
    background: #082f49;
    color: #64748b;
  }

  .cell.ship {
    background: #14532d;
    color: #bbf7d0;
  }

  .cell.hit {
    background: #7f1d1d;
    color: #fecaca;
  }

  .cell.miss {
    background: #713f12;
    color: #fde68a;
  }

  .cell.cursor {
    outline: 2px solid #22d3ee;
    outline-offset: -2px;
  }

  .cell.preview {
    background: #155e75;
  }

  .cell.bad {
    background: #991b1b;
  }

</style>

<script>
  const el = (id) => document.getElementById(id);

  function loadApiBase() {
    const saved = localStorage.getItem('bn_api_base');
    if (saved) el('api-base').value = saved;
    else el('api-base').value = `${location.protocol}//${location.hostname}:8080`;
  }

  el('btn-open')?.addEventListener('click', () => {
    const base = el('api-base').value.trim().replace(/\/$/, '');
    localStorage.setItem('bn_api_base', base);
    window.location.href = `${base}/`;
  });

  loadApiBase();
</script>
